{
  "name": "lisiere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:quick": "vitest run tests/test-output.test.ts tests/fire-flora-save.test.ts tests/visitor-meal-reservation.test.ts tests/roofing.test.ts tests/breakdowns-v144.test.ts tests/breakdown-presentation-v144.test.ts tests/autodoor-world-v143.test.ts tests/autodoor-v143.test.ts tests/advanced-fabrication-v139.test.ts",
    "test:regression": "node scripts/test-regression.mjs",
    "test:campaign": "node scripts/test-campaigns.mjs",
    "test:campaign:diagnostic": "node scripts/test-campaigns.mjs --diagnostic",
    "test:integration": "playwright test",
    "bench": "node --experimental-strip-types scripts/benchmark.ts",
    "test:presentation": "node scripts/check-presentation.mjs",
    "check:docs": "python scripts/check-docs.py",
    "check": "npm run test && npm run build && npm run test:integration && npm run test:presentation && npm run check:docs"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/three": "0.186.0",
    "@webgpu/types": "0.1.72",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
